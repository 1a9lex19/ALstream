<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('partials/head', { title: 'Admin Login - ALStream' }) %>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <div class="login-container">
        <div class="login-box">
            <div class="logo">
                <a href="/"><span class="highlight">AL</span>Stream</a>
            </div>

            <h1>Admin Panel</h1>
            <p>Connectez-vous pour accéder à l'administration</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-message">
                    <i class="fas fa-exclamation-triangle"></i>
                    <%= error %>
                </div>
            <% } %>

            <form action="/admin/login" method="POST">
                <div class="form-group">
                    <label for="password"><i class="fas fa-key"></i> Mot de passe</label>
                    <input type="password" id="password" name="password" placeholder="Entrez le mot de passe" required>
                </div>
                <button type="submit" class="login-btn">
                    Se connecter <i class="fas fa-arrow-right" style="margin-left: 5px;"></i>
                </button>
            </form>

            <div class="login-footer">
                <p>© 2026 ALStream - Admin Only</p>
                <a href="/" style="color: #666; font-size: 0.8rem; text-decoration: underline;">Retour au site</a>
            </div>
        </div>
    </div>
</body>
</html>