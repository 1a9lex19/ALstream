<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Paramètres - ALStream</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
        }

        body {
            background-color: #212121; /* Fond principal */
            color: #ececec; /* Texte clair */
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* SIDEBAR GAUCHE */
        .settings-sidebar {
            width: 260px;
            background-color: #171717;
            padding: 20px 15px;
            display: flex;
            flex-direction: column;
            border-right: 1px solid #333;
        }

        .close-btn {
            background: none;
            border: none;
            color: #ececec;
            font-size: 1.2rem;
            cursor: pointer;
            margin-bottom: 30px;
            width: fit-content;
            padding: 5px;
            transition: color 0.2s;
        }
        .close-btn:hover {
            color: #fff;
        }

        .menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 15px;
            border-radius: 8px;
            color: #ececec;
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
            margin-bottom: 2px;
        }

        .menu-item i {
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
            color: #ececec;
        }

        .menu-item:hover {
            background-color: #2a2a2a;
        }

        .menu-item.active {
            background-color: #303030;
        }

        /* CONTENU PRINCIPAL */
        .settings-content {
            flex: 1;
            padding: 40px 60px;
            overflow-y: auto;
            background-color: #212121;
        }

        .settings-container {
            max-width: 700px;
        }

        .section-title {
            font-size: 1.5rem;
            font-weight: 500;
            margin-bottom: 20px;
            color: #fff;
        }

        .section-divider {
            height: 1px;
            background-color: #383838;
            margin-bottom: 10px;
        }

        /* LIGNE DE RÉGLAGE */
        .setting-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 0;
            border-bottom: 1px solid #383838;
        }

        /* Exception: no border on last item if needed, but the image shows them on every item mostly */
        
        .setting-info {
            display: flex;
            flex-direction: column;
            gap: 5px;
            max-width: 70%;
        }

        .setting-name {
            font-size: 0.95rem;
            color: #ececec;
        }

        .setting-desc {
            font-size: 0.85rem;
            color: #9b9b9b;
            line-height: 1.4;
        }

        .setting-action {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #ececec;
            font-size: 0.95rem;
            cursor: pointer;
        }

        .setting-action i.fa-chevron-down {
            font-size: 0.8rem;
            color: #b0b0b0;
        }

        /* COLOR DOT */
        .color-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #3b82f6; /* Bleu */
            display: inline-block;
        }

        /* PLAY BUTTON FOR VOICE */
        .play-voice {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-right: 15px;
        }

        /* TOGGLE SWITCH */
        .toggle-switch {
            position: relative;
            width: 44px;
            height: 24px;
            appearance: none;
            background-color: #4a4a4a;
            border-radius: 12px;
            outline: none;
            cursor: pointer;
            transition: background 0.3s;
        }
        .toggle-switch:checked {
            background-color: #10a37f; /* Vert ChatGPT par exemple, ou blanc ? L'image a un toggle gris avec bouton blanc */
        }
        .toggle-switch::after {
            content: '';
            position: absolute;
            top: 2px;
            left: 2px;
            width: 20px;
            height: 20px;
            background-color: #fff;
            border-radius: 50%;
            transition: transform 0.3s;
        }
        .toggle-switch:checked::after {
            transform: translateX(20px);
        }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <div class="settings-sidebar">
        <button class="close-btn" onclick="window.location.href='/catalog'" title="Fermer">
            <i class="fas fa-times"></i>
        </button>

        <a href="#general" class="menu-item active" id="menu-general" onclick="showTab('general', this)">
            <i class="fas fa-cog"></i> Général
        </a>
        <a href="#compte" class="menu-item" id="menu-compte" onclick="showTab('compte', this)">
            <i class="far fa-user"></i> Compte
        </a>
    </div>

    <!-- CONTENU -->
    <div class="settings-content">
        <div class="settings-container">
            
            <div id="general" class="tab-content">
                <h2 class="section-title">Général</h2>
                <div class="section-divider"></div>

                <div class="setting-row">
                    <div class="setting-name">Thème</div>
                    <div class="setting-action">
                        Système <i class="fas fa-chevron-down"></i>
                    </div>
                </div>

                <div class="setting-row">
                    <div class="setting-name">Langue</div>
                    <div class="setting-action">
                        Français <i class="fas fa-chevron-down"></i>
                    </div>
                </div>
            </div>

            <div id="compte" class="tab-content" style="display: none;">
                <h2 class="section-title">Compte</h2>
                <div class="section-divider"></div>

                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Profil</div>
                        <div class="setting-desc">
                            <%= user ? user.username : 'Non connecté' %>
                        </div>
                    </div>
                    <% if (user) { %>
                    <div class="setting-action" style="color: #e63946; font-weight: bold; cursor: pointer;" onclick="window.location.href='/logout'">
                        <i class="fas fa-sign-out-alt"></i> Se déconnecter
                    </div>
                    <% } else { %>
                    <div class="setting-action" style="color: #3b82f6; font-weight: bold; cursor: pointer;" onclick="window.location.href='/login'">
                        <i class="fas fa-sign-in-alt"></i> Se connecter
                    </div>
                    <% } %>
                </div>
            </div>

        </div>
    </div>

    <script>
        function showTab(tabId, element) {
            // Cacher toutes les sections
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.style.display = 'none';
            });
            
            // Retirer la classe 'active' de tous les menus
            document.querySelectorAll('.menu-item').forEach(menu => {
                menu.classList.remove('active');
            });
            
            // Afficher la section demandée et activer le menu
            document.getElementById(tabId).style.display = 'block';
            element.classList.add('active');
        }
    </script>
</body>
</html>
