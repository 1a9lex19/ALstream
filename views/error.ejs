<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('partials/head', { title: 'Erreur - ALStream' }) %>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="layout-container">
        <!-- Pas de sidebar sur la page d'erreur pour centrer le message -->
        
        <main class="content" style="display: flex; justify-content: center; align-items: center; min-height: 70vh;">
            <div style="text-align: center; max-width: 600px;">
                <div style="font-size: 5rem; color: var(--accent); margin-bottom: 20px;">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                
                <h1 style="font-size: 2.5rem; margin-bottom: 15px;">Oups !</h1>
                
                <p style="font-size: 1.2rem; color: #aaa; margin-bottom: 30px;">
                    <%= typeof message !== 'undefined' ? message : 'Une erreur inattendue est survenue.' %>
                </p>

                <a href="/catalog" class="btn-watch" style="text-decoration: none;">
                    <i class="fas fa-arrow-left"></i> Retour au catalogue
                </a>
            </div>
        </main>
    </div>

    <%- include('partials/footer') %>
</body>
</html>