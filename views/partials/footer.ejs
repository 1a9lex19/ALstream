    <a href="#" class="back-to-top" id="backToTop">
        <i class="fa-solid fa-arrow-up"></i>
    </a>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const backToTopBtn = document.getElementById("backToTop");
            const footer = document.querySelector("footer.site-footer");

            if (!backToTopBtn || !footer) return;

            function handleScroll() {
                if (window.scrollY > 300) {
                    backToTopBtn.classList.add("show");
                } else {
                    backToTopBtn.classList.remove("show");
                }

                const footerRect = footer.getBoundingClientRect();
                const windowHeight = window.innerHeight;
                const margin = 30; // Marge entre le bouton et le footer

                if (footerRect.top < windowHeight) {
                    const newBottom = (windowHeight - footerRect.top) + margin; 
                    backToTopBtn.style.bottom = `${newBottom}px`;
                } else {
                    backToTopBtn.style.bottom = `${margin}px`;
                }
            }

            window.addEventListener("scroll", handleScroll);

            backToTopBtn.addEventListener("click", (e) => {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: "smooth" });
            });
        });
    </script>
</footer>